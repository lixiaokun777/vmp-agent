# 运行模式：宿主机首次纳管必须使用 kvm-readonly，不会执行任何写操作。
AGENT_MODE=kvm-readonly

# KVM 写操作总开关；只读环境必须保持 false。
KVM_WRITE_ENABLED=false

# KVM 写模式的二次确认值；只有主动填写 enable-kvm-write 才能通过启动校验。
KVM_WRITE_CONFIRMATION=disabled

# Agent 在平台中的唯一名称，建议与宿主机名保持一致。
AGENT_NAME=node-name

# 控制面地址，不要在末尾添加斜杠。
CONTROL_PLANE_URL=https://control-plane.example.internal

# 宿主机首次注册使用的引导令牌，正式环境必须替换。
AGENT_BOOTSTRAP_TOKEN=replace-with-one-time-token

# Agent 心跳和任务通信使用的运行令牌，正式环境必须替换。
AGENT_RUNTIME_TOKEN=replace-with-issued-runtime-token

# libvirt 连接地址，系统级 KVM 默认使用 qemu:///system。
KVM_LIBVIRT_URI=qemu:///system

# 虚拟化工具的绝对路径，Agent 启动前会检查它们是否存在。
KVM_VIRSH_PATH=/usr/bin/virsh
KVM_QEMU_IMG_PATH=/usr/bin/qemu-img
KVM_SEED_TOOL_PATH=/usr/bin/genisoimage

# IP 占用探测工具；创建虚拟机前必须探测目标 IP。
KVM_PING_PATH=/usr/bin/ping

# 平台专用的临时虚机数据目录，禁止指向存量虚机目录或根目录。
KVM_STORAGE_ROOT=/data/kvm-images/ephemeral

# 只读基础镜像目录，创建虚机时将从这里选择镜像。
KVM_IMAGE_ROOT=/data/cloud-init/images

# 允许 Agent 使用的网桥白名单，多个网桥用英文逗号分隔。
KVM_ALLOWED_BRIDGES=br0

# libvirt QEMU 进程的运行组；实例目录、系统盘和 seed 只向该组开放所需权限。
KVM_RUNTIME_GROUP=kvm

# 平台可调度的 CPU 上限；0 表示按宿主机实际可用量计算。
ALLOCATABLE_CPU=0

# 平台可调度的内存上限，单位 MB，不是宿主机物理总内存。
ALLOCATABLE_MEMORY_MB=40960

# 平台可调度的磁盘上限，单位 GB；0 表示按专用目录实际可用空间计算。
ALLOCATABLE_DISK_GB=0

# 为宿主机和存量虚机保留的安全内存，单位 MB。
KVM_SAFETY_MEMORY_MB=10240
